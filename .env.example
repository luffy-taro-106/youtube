# Copy this file to ".env" and fill in your keys.

# NewsAPI.org  — free key at https://newsapi.org/register
NEWSAPI_KEY=

# YouTube Data API v3 — create at https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" for the project, then make an API key.
YOUTUBE_API_KEY=

# Anthropic (Claude) — for the topic selection engine (npm run topics)
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Optional tuning (defaults shown) ---
# How many news items per pillar
NEWS_PER_PILLAR=10
# Only consider competitor videos newer than this many days
VIDEO_LOOKBACK_DAYS=60
# Minimum views for a competitor video to be included
VIDEO_MIN_VIEWS=20000
# Max videos to keep per competitor channel
VIDEO_PER_CHANNEL=8

# --- Google Trends (no key needed; best-effort enrichment) ---
# Country code for trends data
TREND_GEO=US
# Trends lookback window (Google syntax): "today 3-m", "today 12-m", "now 7-d"
TREND_TIMEFRAME=today 3-m
# Max rising queries kept per seed keyword
TREND_QUERIES_PER_SEED=8
