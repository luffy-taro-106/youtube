# Copy this file to ".env" and fill in the key.

# Anthropic (Claude) — for the script + scene + metadata agents.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OAuth callback port for `npm run yt:auth`. Must match the redirect URI in your
# Google Cloud OAuth client (this channel's client uses localhost:5858).
OAUTH_PORT=5858
